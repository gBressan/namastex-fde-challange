# Copie para .env e preencha. O .env nunca vai para o git.
# Dentro do docker compose, QUOTE_API_URL e DATABASE_URL são sobrescritas para os nomes dos serviços.

# API de cotação (quote-service)
QUOTE_API_URL=http://localhost:8000

# Postgres (sobe com o docker compose; porta configurável com POSTGRES_PORT)
DATABASE_URL=postgresql://autoseguro:autoseguro@localhost:5432/autoseguro
# POSTGRES_PORT=5432

# LLM. Padrão: Qwen 3.5 4B local no Ollama (container `ollama`), sem custo e sem token.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Alternativa: qualquer API compatível com a da OpenAI, como o router do Hugging Face.
# O token vem de LLM_API_KEY, de HF_TOKEN ou do login do hf CLI (`hf auth login`); a conta
# precisa da permissão "Make calls to Inference Providers" e de créditos.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=Qwen/Qwen3.5-27B:deepinfra
# LLM_API_KEY=

# Cliente da cotação (ver docs/entregas/B1-cotacao-resiliente.md)
QUOTE_TIMEOUT_S=2.5
QUOTE_MAX_ATTEMPTS=4
QUOTE_DEADLINE_S=12

# Logs: json (padrão) ou console (legível no terminal)
LOG_LEVEL=INFO
LOG_FORMAT=console
