# Copie para .env e preencha. O .env nunca vai para o git.
# Dentro do docker compose, QUOTE_API_URL e DATABASE_URL são sobrescritas para os nomes dos serviços.

# API de cotação (quote-service)
QUOTE_API_URL=http://localhost:8000

# Postgres (sobe com o docker compose; porta configurável com POSTGRES_PORT)
DATABASE_URL=postgresql://autoseguro:autoseguro@localhost:5432/autoseguro
# POSTGRES_PORT=5432

# LLM: qualquer endpoint compatível com a API da OpenAI.
# Padrão: Hugging Face Inference Providers. Token em https://huggingface.co/settings/tokens
# com a permissão "Make calls to Inference Providers".
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen3.5-27B
LLM_API_KEY=

# Cliente da cotação (ver docs/entregas/B1-cotacao-resiliente.md)
QUOTE_TIMEOUT_S=2.5
QUOTE_MAX_ATTEMPTS=4
QUOTE_DEADLINE_S=12

# Logs: json (padrão) ou console (legível no terminal)
LOG_LEVEL=INFO
LOG_FORMAT=console
